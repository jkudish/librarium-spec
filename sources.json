{
  "$schema": "./schema/sources.schema.json",
  "spec": "librarium.sources/1",
  "notes": "Order is catalog order (used by the budget rule). 'js' and 'php' are the legacy profile ids each variant replaces; null means not available in that language today. Pricing stays in each package (JS pricing snapshot, PHP laravel-ai-pricing).",
  "sources": [
    {
      "id": "brave",
      "name": "Brave",
      "kind": "research",
      "docs": "https://brave.com/search/api/",
      "variants": {
        "quick": {
          "js": "brave-answers/grounded",
          "php": "brave-answers",
          "env": "BRAVE_ANSWERS_API_KEY"
        }
      },
      "options": {
        "results": {
          "default": "answer",
          "values": [
            "answer",
            "search"
          ],
          "variants": {
            "search": {
              "js": "brave-search/search",
              "php": "brave-search",
              "env": "BRAVE_API_KEY"
            }
          }
        }
      },
      "php_credential": "services.brave.key"
    },
    {
      "id": "claude",
      "name": "Claude",
