    {
      "id": "google",
      "name": "Google results",
      "kind": "research",
      "docs": "https://librarium.agentsy.build/docs/providers",
      "variants": {
        "quick": {
          "js": "searchapi/search",
          "php": "searchapi",
          "env": "SEARCHAPI_API_KEY"
        }
      },
      "options": {
        "collector": {
          "default": "searchapi",
          "values": [
            "searchapi",
            "serpapi",
            "serpbase"
          ],
          "variants": {
            "serpapi": {
              "js": "serpapi/search",
              "php": "serpapi",
              "env": "SERPAPI_API_KEY"
            },
            "serpbase": {
              "js": "serpbase/search",
              "php": "serpbase-search",
              "env": "SERPBASE_API_KEY"
            }
          }
        },
        "vertical": {
          "default": "web",
          "values": [
            "web",
            "news"
          ],
          "variants": {
            "news": {
              "js": "serpbase/news",
              "php": "serpbase-news",
              "env": "SERPBASE_API_KEY",
              "requires": {
                "collector": "serpbase"
              }
            }
          }
        }
      },
      "php_credential": "services.<collector>.key",
      "notes": "Credential follows the collector."
    },
