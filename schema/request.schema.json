{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/jkudish/librarium-spec/main/schema/request.schema.json",
  "title": "Librarium research request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "question"
  ],
  "properties": {
    "question": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "depth": {
      "enum": [
        "quick",
        "deep"
      ],
      "default": "quick"
    },
    "only": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$",
        "maxLength": 64
      },
      "uniqueItems": true,
      "minItems": 1,
      "maxItems": 64
    },
    "skip": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$",
        "maxLength": 64
      },
      "uniqueItems": true,
      "maxItems": 64
    },
    "max_cost": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
    },
    "dry_run": {
      "type": "boolean",
      "default": false
    },
    "options": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$",
        "maxLength": 64
      },
      "additionalProperties": {
        "type": "object"
      }
    }
  }
}
