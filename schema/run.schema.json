{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/jkudish/librarium-spec/main/schema/run.schema.json",
  "title": "Librarium Run",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "spec",
    "id",
    "question",
    "depth",
    "status",
    "created_at",
    "finished_at",
    "cost",
    "results",
    "skipped",
    "notices"
  ],
  "properties": {
    "spec": {
      "const": "librarium.run/1"
    },
    "id": {
      "type": "string",
      "pattern": "^run_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "depth": {
      "enum": [
        "quick",
        "deep"
      ]
    },
    "status": {
      "enum": [
        "planned",
        "running",
        "done",
        "partial",
        "failed"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "estimated",
        "reported",
        "complete",
        "max"
      ],
      "properties": {
        "estimated": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
            },
            {
              "type": "null"
            }
          ]
        },
        "reported": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
            },
            {
              "type": "null"
            }
          ]
        },
        "complete": {
          "type": "boolean"
        },
        "max": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "results": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/result"
      }
    },
    "skipped": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "reason"
        ],
        "properties": {
          "source": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$",
            "maxLength": 64
          },
          "reason": {
            "enum": [
              "not_configured",
              "no_deep_variant",
              "unpriced",
              "over_budget",
              "excluded",
              "no_collector"
            ]
          }
        }
      }
    },
    "notices": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "status",
        "observation",
        "answer",
        "citations",
        "cost",
        "started_at",
        "duration_ms",
        "provenance",
        "error"
      ],
      "properties": {
        "source": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "maxLength": 64
        },
        "status": {
          "enum": [
            "queued",
            "running",
            "done",
            "failed"
          ]
        },
        "observation": {
          "enum": [
            "api",
            "surface"
          ]
        },
        "answer": {
          "type": [
            "string",
            "null"
          ]
        },
        "citations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "url"
            ],
            "properties": {
              "url": {
                "type": "string",
                "format": "uri"
              },
              "title": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "cost": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "estimated",
            "reported"
          ],
          "properties": {
            "estimated": {
              "oneOf": [
                {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "reported": {
              "oneOf": [
                {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "started_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "duration_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "provider",
            "variant",
            "model",
            "collector"
          ],
          "properties": {
            "provider": {
              "type": "string"
            },
            "variant": {
              "type": "string"
            },
            "model": {
              "type": [
                "string",
                "null"
              ]
            },
            "collector": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "error": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "code",
                "message",
                "retryable"
              ],
              "properties": {
                "code": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                },
                "retryable": {
                  "type": "boolean"
                }
              }
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "failed"
              }
            }
          },
          "then": {
            "properties": {
              "error": {
                "type": "object"
              }
            }
          },
          "else": {
            "properties": {
              "error": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "planned",
              "running"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "finished_at": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "finished_at": {
            "type": "string"
          }
        }
      }
    }
  ]
}
